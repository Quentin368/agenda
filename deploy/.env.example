# Réglages de l'agenda — copier en /home/quentin/docker/agenda/.env (chmod 600). Aucun secret ici.
# Adresse de Radicale vue depuis le conteneur (réseau Docker partagé avec la pile Radicale)
RADICALE_URL=http://radicale:5232/
# Durée de session sans activité : 12 h, ou 30 jours avec « Rester connecté »
SESSION_HOURS=12
REMEMBER_DAYS=30
# Accès en HTTP simple via Tailscale : le cookie ne peut pas exiger HTTPS (mettre true derrière HTTPS)
COOKIE_SECURE=false
# Connexion : 5 échecs en 15 min bloquent l'adresse IP et l'identifiant pendant 15 min
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
# Proxy de confiance (Tailscale Serve, HTTPS) dont on croit X-Forwarded-For pour la limitation des essais :
#   auto = la passerelle Docker du conteneur (par où arrive Tailscale Serve) ; none ; ou une liste d'adresses/réseaux
TRUSTED_PROXIES=auto
# Calendriers modifiables (motifs séparés par des virgules). Vide = lecture seule.
#   Essais : dev-agenda,dev-*      Utilisation normale : *
WRITABLE_CALENDARS=*
